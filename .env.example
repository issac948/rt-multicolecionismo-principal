# =====================================================================
# Variáveis de ambiente da loja. Copie para ".env" e preencha.
# NUNCA coloque este arquivo preenchido no Git nem no frontend.
# =====================================================================

# --- Banco de dados (PostgreSQL) -------------------------------------
DATABASE_URL=postgres://loja:troque_esta_senha@localhost:5432/loja

# --- Endereço público da loja (sem barra no final) --------------------
# Usado em links absolutos, sitemap, Open Graph, retorno do pagamento e webhook.
SITE_URL=http://localhost:3000

# --- Armazenamento de imagens -----------------------------------------
# Pasta no servidor onde as imagens enviadas pelo painel são guardadas.
# Em produção use um volume persistente.
UPLOAD_DIR=./storage/uploads

# --- Rotina de manutenção (cron) ---------------------------------------
# Segredo para chamar GET/POST /api/cron/maintenance (cancela pedidos não pagos
# expirados e devolve o estoque). Gere com: openssl rand -hex 32
CRON_SECRET=

# --- Proxy reverso ------------------------------------------------------
# "true" somente se a loja estiver atrás de um proxy confiável (Nginx, Caddy,
# Cloudflare...). Faz o limitador de tentativas usar X-Forwarded-For.
TRUST_PROXY=false

# --- Pagamento: qual serviço usar ----------------------------------------
# paypal (padrão, conta PayPal do negócio) | infinitepay (conta InfinitePay) | mercadopago (opcional)
PAYMENT_PROVIDER=paypal

# --- Pagamento: PayPal ---------------------------------------------------
# developer.paypal.com > Apps & Credentials: crie um app (primeiro em "Sandbox", para testar) e copie:
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# ID do webhook (Apps & Credentials > seu app > Webhooks > Add webhook). URL: SITE_URL + /api/webhooks/paypal
# Eventos: Checkout order approved; Payment capture completed/pending/denied/refunded/reversed.
PAYPAL_WEBHOOK_ID=
# sandbox = testes (sem dinheiro de verdade) | live = vendas reais (credenciais "Live")
PAYPAL_ENV=sandbox
# Opcional: só para testes locais contra um servidor simulado. Deixe em branco.
PAYPAL_API_BASE=

# --- Pagamento: InfinitePay (só se PAYMENT_PROVIDER=infinitepay) ----------------
# Sua InfiniteTag (no app InfinitePay), com ou sem o "$". Ex.: minha_loja
INFINITEPAY_HANDLE=
# Segredo que vai no endereço do webhook (mínimo 16 caracteres; o InfinitePay não assina as notificações).
# Gere com: openssl rand -hex 24   (no Windows: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))")
INFINITEPAY_WEBHOOK_TOKEN=
# Opcional: só para testes locais contra um servidor simulado. Deixe em branco em produção.
INFINITEPAY_API_BASE=

# --- Pagamento: Mercado Pago (opcional; só se PAYMENT_PROVIDER=mercadopago) ----
# Access Token da aplicação (painel de desenvolvedores do Mercado Pago).
# Use o token de TESTE enquanto estiver testando e o de PRODUÇÃO para vender de verdade.
MERCADOPAGO_ACCESS_TOKEN=
# "Assinatura secreta" da aba Webhooks da aplicação. Sem ela, o webhook é recusado.
MERCADOPAGO_WEBHOOK_SECRET=
# Opcional: só para testes locais contra um servidor simulado. Deixe em branco em produção.
MERCADOPAGO_API_BASE=

# --- Frete calculado pelo CEP (SuperFrete: SEDEX, PAC, Mini Envios) -----------
# Só é usado se, em Painel > Configurações > Entrega, você escolher "Calculado pelo CEP do cliente".
# O endereço de ORIGEM (de onde você posta) é preenchido no painel, não aqui.
# Token de API da sua conta SuperFrete (gerado no painel da SuperFrete, na área de integrações/API). Nunca coloque no Git.
SUPERFRETE_TOKEN=
# Opcional: seu e-mail, enviado no cabeçalho User-Agent como a SuperFrete pede.
SUPERFRETE_CONTACT_EMAIL=
# Opcional: tempo máximo de espera pela SuperFrete, em milissegundos (padrão 6000).
# Passou disso, a loja usa o valor fixo de reserva configurado no painel.
SUPERFRETE_TIMEOUT_MS=
# Opcional: só para testes locais contra um servidor simulado. Deixe em branco em produção.
SUPERFRETE_API_BASE=

# --- Inteligência artificial (painel do dono + assistente da loja) ---------------
# anthropic | openai | none   (openai = qualquer API compatível com o formato OpenAI)
AI_PROVIDER=none
AI_API_KEY=
# Modelo usado pelo provedor escolhido. Ex.: claude-sonnet-5-5
AI_MODEL=
# Só para AI_PROVIDER=openai: URL base da API compatível (padrão https://api.openai.com/v1)
AI_BASE_URL=
# Teto de perguntas por dia no assistente que atende os CLIENTES (protege o seu gasto). Padrão 500.
AI_SHOP_DAILY_LIMIT=500
