# =====================================================================
# Variáveis de ambiente da loja. Copie para ".env" e preencha.
# NUNCA coloque este arquivo preenchido no Git nem no frontend.
# =====================================================================

# No Netlify, estas variáveis NÃO ficam neste arquivo: cadastre uma a uma em
# Site configuration > Environment variables. Nunca envie valores por chat ou e-mail.

# --- Banco de dados (PostgreSQL) -------------------------------------
# Neon: no SITE (Netlify) use a conexão "pooled" (endereço com "-pooler") e "?sslmode=require".
# Para rodar migrações (npm run db:migrate) use a conexão DIRETA (sem "-pooler").
DATABASE_URL=postgres://loja:troque_esta_senha@localhost:5432/loja
# Opcional: conexões abertas por instância da loja (padrão 10; no Netlify, 3).
DATABASE_POOL_MAX=
# Tamanho do seu plano de banco, em MB (padrão 512). Neon Free = 1024. A loja bloqueia novas fotos quando o banco
# chega a 90% disso, para nunca faltar espaço para os pedidos.
DATABASE_PLAN_LIMIT_MB=

# --- Endereço público da loja (sem barra no final) --------------------
# Usado em links absolutos, sitemap, Open Graph, retorno do pagamento, webhook e na manutenção agendada do Netlify.
SITE_URL=http://localhost:3000

# --- Armazenamento de fotos -------------------------------------------
# Onde as fotos enviadas pelo painel ficam:
#   local    = pasta do servidor (UPLOAD_DIR). Padrão no computador e em servidor próprio.
#   database = dentro do PostgreSQL da loja. Padrão no Netlify (que não tem pasta permanente).
#   s3       = serviço externo compatível com S3 (Cloudflare R2, Neon Object Storage...).
# Em branco: a loja escolhe sozinha (Netlify = database; o resto = local). Veja o README ("Imagens e armazenamento").
STORAGE_DRIVER=
# Só com "local": pasta das imagens. Em produção use um volume persistente.
UPLOAD_DIR=./storage/uploads
# Só com "database": teto, em MB, das fotos guardadas no banco (padrão 300). Passou disso, novos envios são recusados.
STORAGE_DB_MAX_MB=
# Só com "s3": dados do serviço externo (a chave secreta nunca vai para o navegador). Região "auto" no Cloudflare R2.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Opcional (s3): endereço público do bucket, sem barra no final. Com ele as fotos saem direto do serviço;
# sem ele, saem pela própria loja em /uploads/...
STORAGE_PUBLIC_BASE_URL=

# --- Rotina de manutenção (cron) ---------------------------------------
# Segredo (16+ caracteres) para chamar GET/POST /api/cron/maintenance: cancela pedidos NÃO PAGOS com prazo vencido
# (devolvendo o estoque) e limpa sessões, fotos abandonadas e registros antigos.
# NO NETLIFY É OBRIGATÓRIO: a função agendada (netlify/functions/manutencao.mts, de hora em hora) usa este segredo.
# Em servidor próprio é opcional: a loja já roda a manutenção sozinha a cada 5 minutos.
# Gere com: openssl rand -hex 32   (no Windows: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
CRON_SECRET=

# --- Proxy reverso ------------------------------------------------------
# "true" somente se a loja estiver atrás de um proxy confiável (Nginx, Caddy,
# Cloudflare...). Faz o limitador de tentativas usar X-Forwarded-For.
TRUST_PROXY=false

# --- Pagamento: qual serviço usar ----------------------------------------
# paypal (conta PayPal do negócio) | infinitepay (conta InfinitePay) | mercadopago (opcional)
# ATENÇÃO: se esta variável não existir, a loja usa "paypal". Quem usa InfinitePay precisa definir "infinitepay"
# (no Netlify, também como variável de ambiente).
PAYMENT_PROVIDER=paypal

# --- Pagamento: PayPal ---------------------------------------------------
# developer.paypal.com > Apps & Credentials: crie um app (primeiro em "Sandbox", para testar) e copie:
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# ID do webhook (Apps & Credentials > seu app > Webhooks > Add webhook). URL: SITE_URL + /api/webhooks/paypal
# Eventos: Checkout order approved; Payment capture completed/pending/denied/refunded/reversed.
PAYPAL_WEBHOOK_ID=
# sandbox = testes (sem dinheiro de verdade) | live = vendas reais (credenciais "Live")
PAYPAL_ENV=sandbox
# Opcional: só para testes locais contra um servidor simulado. Deixe em branco.
PAYPAL_API_BASE=

# --- Pagamento: InfinitePay (só se PAYMENT_PROVIDER=infinitepay) ----------------
# Sua InfiniteTag (no app InfinitePay), com ou sem o "$". Ex.: minha_loja
INFINITEPAY_HANDLE=
# Segredo que vai no endereço do webhook (mínimo 16 caracteres; o InfinitePay não assina as notificações).
# Gere com: openssl rand -hex 24   (no Windows: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))")
INFINITEPAY_WEBHOOK_TOKEN=
# Opcional: só para testes locais contra um servidor simulado. Deixe em branco em produção.
INFINITEPAY_API_BASE=

# --- Pagamento: Mercado Pago (opcional; só se PAYMENT_PROVIDER=mercadopago) ----
# Access Token da aplicação (painel de desenvolvedores do Mercado Pago).
# Use o token de TESTE enquanto estiver testando e o de PRODUÇÃO para vender de verdade.
MERCADOPAGO_ACCESS_TOKEN=
# "Assinatura secreta" da aba Webhooks da aplicação. Sem ela, o webhook é recusado.
MERCADOPAGO_WEBHOOK_SECRET=
# Opcional: só para testes locais contra um servidor simulado. Deixe em branco em produção.
MERCADOPAGO_API_BASE=

# --- Frete calculado pelo CEP (SuperFrete: SEDEX, PAC, Mini Envios) -----------
# Só é usado se, em Painel > Configurações > Entrega, você escolher "Calculado pelo CEP do cliente".
# O endereço de ORIGEM (de onde você posta) é preenchido no painel, não aqui.
# Token de API da sua conta SuperFrete (gerado no painel da SuperFrete, na área de integrações/API). Nunca coloque no Git.
SUPERFRETE_TOKEN=
# Opcional: seu e-mail, enviado no cabeçalho User-Agent como a SuperFrete pede.
SUPERFRETE_CONTACT_EMAIL=
# Opcional: tempo máximo de espera pela SuperFrete, em milissegundos (padrão 6000).
# Passou disso, a loja usa o valor fixo de reserva configurado no painel.
SUPERFRETE_TIMEOUT_MS=
# Opcional: só para testes locais contra um servidor simulado. Deixe em branco em produção.
SUPERFRETE_API_BASE=

# --- Inteligência artificial (painel do dono + assistente da loja) ---------------
# anthropic | openai | none   (openai = qualquer API compatível com o formato OpenAI)
AI_PROVIDER=none
AI_API_KEY=
# Modelo usado pelo provedor escolhido. Ex.: claude-sonnet-5-5
AI_MODEL=
# Só para AI_PROVIDER=openai: URL base da API compatível (padrão https://api.openai.com/v1)
AI_BASE_URL=
# Teto de perguntas por dia no assistente que atende os CLIENTES (protege o seu gasto). Padrão 500.
AI_SHOP_DAILY_LIMIT=500

# --- Aviso ao dono pelo Telegram (opcional) -------------------------------------
# Crie um bot com o @BotFather (ele entrega o token), mande uma mensagem ao bot e descubra o ID do chat.
# Sem as duas variáveis, nada é enviado. Os avisos levam só número do pedido e valor (nunca dados do cliente).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Opcional: só para testes locais contra um servidor simulado. Deixe em branco em produção.
TELEGRAM_API_BASE=
