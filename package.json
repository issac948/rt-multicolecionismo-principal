{
  "name": "loja-carrinhos",
  "version": "1.0.0",
  "private": true,
  "description": "Loja virtual de carrinhos com painel administrativo, estoque, pagamento (Mercado Pago) e assistente de IA.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "admin:create": "tsx --env-file-if-exists=.env scripts/create-admin.ts",
    "maintenance": "tsx --env-file-if-exists=.env scripts/maintenance.ts"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource/lobster": "^5.3.0",
    "drizzle-orm": "0.45.3",
    "lucide-react": "1.52.0",
    "next": "16.4.0",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "drizzle-kit": "0.31.11",
    "postcss": "^8.4.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.20.0",
    "typescript": "5.9.3",
    "vitest": "^5.0.3"
  }
}
